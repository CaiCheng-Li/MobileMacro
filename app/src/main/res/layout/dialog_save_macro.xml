<?xml version="1.0" encoding="utf-8"?>
<!-- Name dialog for macros and profiles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/macroNameLayout"
        style="@style/Widget.AutoClicker.Field"
        android:layout_width="match_parent"
        android:hint="@string/macro_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/macroNameField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLength="40"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Shown when editing a profile. -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/replaceLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/profile_replace"
        android:visibility="gone" />
</LinearLayout>
